# Copy to .env.local for local development. In production, set these in the
# hosting dashboard (Vercel → Project → Settings → Environment Variables),
# never in a committed file.

# Postgres database holding all content, accounts, donations and messages.
# Local: run `npm run db:local` and use the line below.
# Production: the Neon connection string.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/postgres

# Public address of the site (canonicals, sitemap, feed). Anything other than
# https://rhagfnig.org.ng is kept out of search engines.
NEXT_PUBLIC_SITE_URL=http://localhost:3700

# Lets the first administrator be created at /admin/setup/ (only works while
# no accounts exist). A random code of 16+ characters; remove it afterwards.
ADMIN_SETUP_TOKEN=

# Uploaded images and PDFs: a public Amazon S3 bucket. The same access key also
# sends email through SES. Leave empty locally: files are then kept in .data/uploads.
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=
# Optional: the public address files are served from (default: the bucket's own,
# https://<bucket>.s3.<region>.amazonaws.com), e.g. a CloudFront address.
NEXT_PUBLIC_MEDIA_URL=

# Email (form alerts, donation receipts) through Amazon SES. Leave these empty to
# use the S3_* key and region above; the key needs ses:SendEmail in the region
# where rhagfnig.org.ng is a verified identity.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
# Where alerts go (default info@rhagfnig.org.ng) and the sender (default no-reply@rhagfnig.org.ng).
FORM_TO=
FORM_FROM=

# Only for `npm run import:wordpress` / `import:extras`: the WordPress site to copy from.
WORDPRESS_URL=https://rhagfnig.org.ng
